# ---------------------------------------------------------------------------
# BTC sniper settings.   cp .env.example .env && chmod 600 .env
#
# The settings below are the ones the sniper is run with. Secrets are listed
# by NAME only - put their values in .env, never here, never in git.
# Paper vs live is chosen on the command line (run.py --live), not here.
# ---------------------------------------------------------------------------

# ---- wallet (LIVE only; paper never reads them) -----------------------------
POLY_PRIVATE_KEY=
POLY_FUNDER=
POLY_SIGNATURE_TYPE=
# Optional: Polygon RPC for on-chain settlement reads (~1 min after a round
# instead of 5-13 min from the CLOB/Gamma mirrors). May embed an API key.
POLYGON_RPC=

# ---- settlement ---------------------------------------------------------------
# Results are read from the chain first (the payout a redemption pays); 0 = the
# CLOB + Gamma mirrors only. Leave unset (on) unless the RPC is unusable.
SETTLE_ONCHAIN=1
# A pending market raises SETTLEMENT_TIMEOUT after this many seconds (still checked).
SETTLE_TIMEOUT_S=900

# ---- the strategy: the sniper and nothing else -----------------------------
SNIPER_ONLY=1
# Trigger: BTC mid moves >= SNIPER_K_BP within SNIPER_WINDOW_MS, on the trigger feed:
# coinbase (Coinbase Exchange BTC-USD ticker + heartbeats - the frozen spec's feed;
# LIVE refuses any other), binance (BTCUSDT bookTicker) or kraken (paper only).
SNIPER_PRIMARY_FEED=coinbase
# Coinbase sockets carrying the same ticker at once: each ticker is used from the
# first socket to deliver it, so one stalling or dropping costs nothing.
SNIPER_COINBASE_CONNS=2
# Optional second trigger beside the ticker - binance_fut = Binance's USD-M
# perpetual BTCUSDT book ticker (raced first on ~75% of shared moves by ~130-150ms).
# Whichever feed signals first fires; one move, one order. Paper and LIVE (empty or binance_fut).
SNIPER_EXTRA_FEEDS=
SNIPER_K_BP=0.5
SNIPER_WINDOW_MS=250
# Order: FAK (= IOC limit: partial fills kept, the rest cancelled). Target SNIPER_SHARES
# plus what this side's last order in this market did not fill, at most
# SNIPER_MAX_TARGET_SHARES; limit = the freshest best ask + SNIPER_SLIP, fixed at the
# decision (never chased, never above MAX_BUY_PRICE). One order buys what is offered
# from that ask up to +5c and nothing above; no retry. The carry dies with its market.
SNIPER_SHARES=10
SNIPER_MAX_TARGET_SHARES=20
SNIPER_ORDER_TYPE=FAK
SNIPER_SLIP=0.05
# Fair value: every buy only at or under the MARKET-ANCHORED fair value - the market's
# own mid for the side just before the move, moved by what a BTC move of that size is
# worth with the 5-minute volatility and the time left - less the taker fee and
# SNIPER_FAIR_MARGIN; the limit is capped there too. Under a minute of history: no buys.
SNIPER_FAIR=1
SNIPER_FAIR_MARGIN=0.01
# Hybrid sizing: quarter Kelly, reduced further for high volatility and realized
# drawdown. Modifiers apply to the desired portfolio allocation BEFORE subtracting
# current inventory. Existing cash, side and live canary limits still apply.
# LIVE requires fair margin 0.01, Kelly on, fraction 0.25 and hybrid sizing on.
SNIPER_KELLY=1
SNIPER_KELLY_FRACTION=0.25
SNIPER_HYBRID_SIZING=1
# More eligible order attempts: one venue-minimum entry per side/round when a
# positive target is too small and there is no same-side inventory or pending risk.
# This can exceed the hybrid target. Cash, fair value, drawdown stop and existing
# limits still apply. 0 restores strict target sizing. Live intents retain claims.
SNIPER_KELLY_MIN_ENTRY=1
# Baseline volatility in basis points per sqrt(second); min(1, baseline / sigma).
# This is an operator-selected baseline, not a fitted optimum. Lower vol never boosts Kelly.
SNIPER_HYBRID_VOL_BASELINE_BP=1.0
# Linear exposure reduction from the persisted realized-equity high-water mark;
# zero new allocation at 20% drawdown. This does not mark open positions to market.
SNIPER_HYBRID_DRAWDOWN_STOP=0.20
# at the stop: this many seconds without orders, then a fresh start from the equity (0: hold until it recovers)
SNIPER_HYBRID_DRAWDOWN_PAUSE_S=600
# Optional NEW per-order all-in spend caps: 0 disables each, as requested.
# Positive values later cap spend including conservative fees; the tighter enabled
# cap applies. Risk fraction is relative to realized equity. Venue minimums still apply.
SNIPER_HYBRID_RISK_FRACTION=0
SNIPER_HYBRID_MAX_ORDER_USD=0
# Confidence stays neutral (1.0) until historical predictive accuracy is validated;
# there is deliberately no manual confidence multiplier. See HYBRID_SIZING.md.
# Per side: an UP order cools down UP only (DOWN stays free), from its submission.
SNIPER_COOLDOWN_MS=300
SNIPER_MIN_LEFT_S=10
SNIPER_MAX_FILLS_ROUND=20
SNIPER_MAX_SIDE_SHARES=200
# Paper order flight times drawn from real live orders (needs >= 30 of them
# in live_sniper.jsonl - setup.sh copies it from the old bot).
SNIPER_DELAY_SOURCE=live
# The delays paper draws from: the shipped copy of 238 real canary orders (2026-10-04..06,
# reply times only - no ids, prices or addresses). Relative paths are the install's.
SNIPER_DELAY_JOURNAL=data/live_delays_2026-10-04.jsonl
# Paper's modelled venue hold (SNIPER_DELAY_SOURCE=model). Polymarket's crypto
# taker delay is 150ms since 2026-09-04 (docs changelog); the default 250 is the
# older value. 150 also moves the end-of-round cutoff 0.1s later - your choice.
# SNIPER_HOLD_MS=150

# ---- account band and round window (the sniper's lab plan) -----------------
MIN_BUY_PRICE=0.05
MAX_BUY_PRICE=0.95
TRADE_LAST_SECONDS=300
MIN_SECONDS_TO_EXPIRY=10

# ---- paper -----------------------------------------------------------------
# Starting cash for the FIRST paper launch only (paper_account.json wins after).
PAPER_START_BALANCE=1000

# ---- position manager (off; see README "Position Manager") -------------------
# A separate layer beside the sniper: buys only when a purchase improves the
# pair cost (new UP+DOWN pairs under $1 after fees) or a held side's average,
# and only if the added capital and worst-case loss pass a second check.
# Paper orders when enabled (FOK: all or nothing); LIVE runs it shadow-only (no orders).
POSITION_MANAGER_ENABLED=0
# Real manager orders: refused until the replay results are reviewed.
POSITION_MANAGER_LIVE_ENABLED=0
# POSITION_MANAGER_MAX_ORDER_USD=10
# POSITION_MANAGER_MAX_MARKET_USD=25
# POSITION_MANAGER_MAX_TOTAL_EXPOSURE=60
# POSITION_MANAGER_MIN_PAIR_IMPROVEMENT=0.02
# POSITION_MANAGER_MIN_AVG_IMPROVEMENT=0.03
# POSITION_MANAGER_MIN_LEFT_S=30

# ---- live canary (run.py --live) ---------------------------------------------
SNIPER_LIVE_CANARY=1
# Optional warm-only execution: skip a signal if the synchronous HTTP/2
# connection is unavailable. Background warming reconnects; that signed order
# is never retried. This can skip opportunities and cannot guarantee 200 ms fills.
# Use the FastH2 transport with this option, not the httpx fallback.
# SNIPER_HTTP=fast
# SNIPER_WARM_ONLY=1
# Polymarket's taker matching delay on these markets; live refuses to start without it.
ASSUMED_MATCH_DELAY_SECONDS=5
USER_WS=on
RECONCILE=auto
# The live ledger (authorized orders + positions). setup.sh copies the old bot's.
LEDGER_PATH=live_ledger.json
LIVE_SNIPER_JOURNAL=live_sniper.jsonl
# Hard caps. Spend is counted at send and never given back for a fill, so
# MAX_SPEND bounds session notional. LOSS bounds realized losses plus the
# conservative cost of open positions and outstanding orders, including fees.
# Canary: 3 markets, $10 worst-case loss budget.
SNIPER_CANARY_MAX_SHARES=25
SNIPER_CANARY_MAX_ORDERS=40
SNIPER_CANARY_MAX_FILLS=20
SNIPER_CANARY_MAX_ROUNDS=3
SNIPER_CANARY_MAX_SPEND_USD=60
SNIPER_CANARY_MAX_LOSS_USD=10
# A Kraken trigger trades live only with this explicit opt-in (and SNIPER_PRIMARY_FEED=kraken).
SNIPER_KRAKEN_LIVE=0
